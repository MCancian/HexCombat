# Godot 4+ engine cache and import artifacts
.godot/

# Mono/.NET (unused, but safe to ignore)
.mono/
data_*/

# Exported builds
/build/
/export/

# GdUnit4 generated test reports
/reports/

# Python bytecode (tools/llm_sidecar*.py)
__pycache__/
*.pyc

# Terrain pipeline venv + local outputs (tools/terrain)
tools/terrain/.venv/
tools/terrain/out/

# Throwaway worktrees created by agy-verify (removed on exit; ignored so a crashed run
# cannot dirty the tree or trip the gate fixture-drift check).
.agy-verify-*/

# Frozen review artifacts (tools/review_fanout.sh) — must live in-repo so workspace-scoped
# reviewer CLIs can read them, but are never committed.
.review-fanout/

# Throwaway measurement probes and scratch scripts. MUST live here, never in tools/:
# tools/*.gd seeds the compile closure that validate_tool_script_purity.gd walks, so a
# scratch script there can fail unrelated gate phases. The gate globs tools/validate_*.gd
# and tests/**/*_test.gd, so nothing here is ever collected. README.md is tracked so the
# directory exists on a fresh checkout and explains itself.
/scratch/*
!/scratch/README.md
