# Godot 4+ engine cache and import artifacts
.godot/

# Mono/.NET (unused, but safe to ignore)
.mono/
data_*/

# Exported builds
/build/
/export/

# GdUnit4 generated test reports
/reports/

# Python bytecode (tools/llm_sidecar*.py)
__pycache__/
*.pyc

# Terrain pipeline venv + local outputs (tools/terrain)
tools/terrain/.venv/
tools/terrain/out/

# Throwaway worktrees created by agy-verify (removed on exit; ignored so a crashed run
# cannot dirty the tree or trip the gate fixture-drift check).
.agy-verify-*/
